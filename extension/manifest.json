{
  "manifest_version": 3,
  "name": "Anime Relay",
  "version": "0.3.3",
  "key": "",
  "description": "Detect anime playback and relay completed episodes to the Anime Relay desktop app.",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "permissions": ["storage", "alarms"],
  "host_permissions": ["http://127.0.0.1:3210/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Anime Relay", "default_popup": "popup.html", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "exclude_matches": [
      "*://youtube.com/*",
      "*://*.youtube.com/*",
      "*://youtu.be/*",
      "*://*.youtu.be/*",
      "*://youtube-nocookie.com/*",
      "*://*.youtube-nocookie.com/*"
    ],
    "js": ["content.js"],
    "run_at": "document_idle",
    "all_frames": true
  }]
}
